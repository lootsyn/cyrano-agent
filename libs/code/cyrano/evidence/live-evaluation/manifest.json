  "statistics": {
    "design": "paired binary outcomes; each baseline/candidate pair shares the same task, seed snapshot and overlay \u2014 pairing is by task",
    "primary_rule": "delta = (wins - losses) / completed_pairs where a win is candidate final pass with baseline not pass; verdict improved iff delta > quality_margin AND every family Wilson-interval lower bound >= -quality_margin; regressed iff delta < -quality_margin; otherwise inconclusive",
    "quality_margin": 0.5,
    "min_pairs": 6,
    "effect_threshold": "with 6 pairs, delta > 0.5 requires at least 4 net wins (4/6 = 0.667); 3/6 = 0.5 does not promote",
    "tie_handling": "both-pass and both-fail pairs contribute 0 to the numerator and count toward completed pairs; a baseline pass where the candidate fails counts as a loss",
    "incomplete_pair_handling": "an incomplete pair is preserved as evidence, never silently repaired, rerun past the sealed retry rule, or replaced; actual_pairs < min_pairs yields INCONCLUSIVE regardless of observed delta",
    "correction_assisted_treatment": "final outcome (primary) credits correction-assisted success; first-pass outcome (secondary) does not",
    "cost_regression_limit": "candidate_total_units <= 3.0 x baseline_total_units; exceeding the limit marks cost_regression=true in the analysis and caps the verdict at inconclusive",
    "freeze": "this rule is sealed into the manifest before any live run and may not change after outcomes are observed"
  },
