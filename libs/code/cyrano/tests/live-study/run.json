{
  "schema_version": "cyrano.live-study-route/1",
  "status": "sealed_route_not_executed",
  "entrypoint": "dcode",
  "invocation": [
    "dcode",
    "-x",
    "<task-prompt>",
    "--workspace",
    "<run-workspace>"
  ],
  "credential_env": "ANTHROPIC_API_KEY",
  "model": {
    "provider": "anthropic",
    "model_spec": "anthropic:claude-sonnet-5",
    "parameters": {}
  },
  "run_order": [
    "task-a-candidate",
    "improvement",
    "task-b-baseline",
    "task-b-candidate"
  ],
  "controls": {
    "same_task_text_both_arms": true,
    "same_model_both_arms": true,
    "same_parameters_both_arms": true,
    "oracle_outside_agent_scope": true,
    "byte_identical_workspace_copies": true
  },
  "caps": {
    "max_runs": 4,
    "max_model_calls": 120,
    "max_tokens": 2500000,
    "max_cost_usd": 20.0,
    "timeout_seconds_per_run": 1800
  }
}
