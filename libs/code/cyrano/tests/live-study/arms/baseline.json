{
  "arm": "baseline",
  "description": "stock dcode run; Cyrano improvement and memory lanes disabled",
  "dcode_release": "deepagents-code==0.1.70",
  "memory_service": "disabled",
  "improvement_lanes": "disabled",
  "action_broker": "disabled",
  "event_ledger": "local scoped repository, observation only",
  "approval": "launch-scope permit for the run itself only",
  "workspace": "byte-identical copy of tests/live-study/repo",
  "model": {
    "provider": "openrouter",
    "model_spec": "openrouter:deepseek/deepseek-v4.1-flash",
    "parameters": {
      "temperature": 0,
      "max_retries": 0,
      "openrouter_provider": {
        "only": ["DeepInfra"],
        "allow_fallbacks": false,
        "require_parameters": true
      }
    }
  },
  "provider_routing": {
    "only": ["DeepInfra"],
    "allow_fallbacks": false,
    "require_parameters": true
  }
}
