{
  "schema_version": "cyrano.broker-policy/2",
  "activation": "disabled_until_verified",
  "approval_actions": [
    "approve_spec_for_planning",
    "approve_plan",
    "authorize_execution",
    "authorize_sandbox_probe",
    "approve_memory_promotion",
    "approve_harness_release",
    "authorize_apply_patch",
    "authorize_evaluation",
    "authorize_release_rollback"
  ],
  "signature": "Ed25519",
  "worker_may_approve": false,
  "permit_ttl_seconds": 900,
  "new_file_requires_exact_approval": true,
  "permissions": [
    "read",
    "create",
    "write_existing",
    "delete",
    "only_write"
  ],
  "only_write": "broker_sink_not_readable_mount",
  "unknown_tool": "deny",
  "unregistered_tool_schema_hash": "deny",
  "separate_principals_required": true,
  "source_writer": "broker_only",
  "source_mount": "readonly",
  "scratch_mount": "isolated_writable",
  "allow_network": false,
  "mount_credentials": false,
  "mount_docker_socket": false,
  "max_command_seconds": 3600,
  "max_output_bytes": 1048576,
  "max_request_bytes": 1048576,
  "max_event_bytes": 65536,
  "max_artifact_bytes": 10485760,
  "json_depth_limit": 32,
  "json_integer_abs_max": 9007199254740991,
  "json_duplicate_keys": "reject",
  "signed_json_floats": "reject",
  "source_apply": "journal_preflight_preimage_CAS_postimage_reconcile",
  "patch_and_code_rollback": "separate_approval_required",
  "protected_roots": [
    ".git",
    "credential_store",
    "approval_keys",
    "active_release",
    "control_database"
  ]
}
