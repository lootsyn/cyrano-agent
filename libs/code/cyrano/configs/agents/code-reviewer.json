{
  "kind": "agent_role",
  "schema_version": "1.0",
  "id": "code-reviewer",
  "description": "하네스 코드 변경과 release 위험 검토",
  "prompt_path": "plugins/cyrano/agents/code-reviewer.md",
  "input_schema": "contracts/v1/cyrano.schema.json#/$defs/AgentTask",
  "output_schema": "contracts/v1/cyrano.schema.json#/$defs/WorkerOutcome",
  "skills": [
    "runtime-code-change",
    "release-review",
    "cyrano-code-intelligence",
    "monitor-investigation"
  ],
  "allowed_tools": [
    "cyrano_evidence_read",
    "cyrano_report_result",
    "cyrano_session_view",
    "cyrano_code_query",
    "cyrano_docs_query"
  ],
  "authority": "proposal_only",
  "context_epoch_policy": "pinned_per_phase",
  "read_scope": "current_task",
  "max_delegation_depth": 0
}
