{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyrano:detail:observability:r4",
  "description": "Implementation target supplemental detail; schema success alone is not authority or effectiveness.",
  "$defs": {
    "PhysicalAttemptObservation": {
      "type": "object",
      "properties": {
        "logical_request_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "main",
            "child",
            "summary",
            "offload",
            "classifier",
            "rubric",
            "reviewer"
          ]
        },
        "retry_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "started",
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "clock_boot_id": {
          "type": "string",
          "minLength": 1
        },
        "start_monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_monotonic_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "usage_semantics": {
          "enum": [
            "included_in_input",
            "separate",
            "unknown"
          ]
        },
        "usage_source": {
          "enum": [
            "provider",
            "native_observer",
            "missing"
          ]
        },
        "cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_kind": {
          "enum": [
            "actual",
            "estimated",
            "unknown"
          ]
        }
      },
      "required": [
        "logical_request_id",
        "physical_attempt_id",
        "attempt_no",
        "role",
        "retry_of",
        "status",
        "clock_boot_id",
        "start_monotonic_ns",
        "end_monotonic_ns",
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "usage_semantics",
        "usage_source",
        "cost_microunits",
        "currency",
        "cost_kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cost_kind": {
                "const": "unknown"
              }
            },
            "required": [
              "cost_kind"
            ]
          },
          "then": {
            "properties": {
              "cost_microunits": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "end_monotonic_ns": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    }
  }
}
