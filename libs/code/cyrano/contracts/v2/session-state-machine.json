  "additional_rules": {
    "transition_evaluation": "explicit transitions first, unique global event match second, otherwise INVALID_TRANSITION",
    "guard_origin": "trusted kernel services, never a model-supplied boolean",
    "terminal_states": [
      "COMPLETED",
      "CANCELLED",
      "FAILED"
    ],
    "terminal_emission": "at most one logical terminal event and one learning job identity per run",
    "failure_effects": "unknown effects prevent terminal FAILED",
