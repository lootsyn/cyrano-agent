    },
    {
      "from": "PLAN_DRAFT",
      "event": "plan_submitted",
      "to": "PLAN_REVIEW",
      "guard_id": "dag_scope_traceability_verification_budget_valid"
    },
    {
      "from": "PLAN_REVIEW",
      "event": "changes_required",
      "to": "PLAN_DRAFT",
