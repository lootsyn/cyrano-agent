{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrano.local/contracts/planning.schema.json",
  "title": "Cyrano current planning and human decision contracts",
  "description": "Implementation specification, not an approval service or a verified product runtime. Select explicit $defs.",
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "tenant",
        "user",
        "workspace"
      ]
    },
    "PlanReviewSubject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "requirements_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "design_decisions_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "work_plan_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_baseline_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "runtime_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "test_plan_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "recovery_recipe_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "budget_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "permission_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "review_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 1,
          "maxItems": 256
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "subject_id",
        "plan_id",
        "revision",
        "scope",
        "requirements_digest",
        "design_decisions_digest",
        "work_plan_digest",
        "source_baseline_digest",
        "policy_digest",
        "runtime_digest",
        "test_plan_digest",
        "recovery_recipe_digest",
        "budget_digest",
        "permission_digest",
        "review_scopes",
        "dependency_ids",
        "subject_digest"
      ],
      "description": "Immutable execution-meaning projection. Digest excludes subject_digest itself and all live status, receipts, progress and signatures."
    },
    "ReviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reviewer_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "author_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "work_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "severity": {
          "enum": [
            "advisory",
            "major",
            "blocking"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "resolution_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "refutation_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "state": {
          "enum": [
            "open",
            "responded",
            "recheck_required",
            "resolved",
            "invalid",
            "risk_accepted",
            "stale"
          ]
        }
      },
      "required": [
        "finding_id",
        "subject_digest",
        "reviewer_run_id",
        "author_run_id",
        "requirement_ids",
        "work_unit_ids",
        "evidence_ids",
        "severity",
        "description",
        "resolution_condition",
        "refutation_condition",
        "state"
      ]
    },
    "FindingResolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "resolving_actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "review_run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "decision": {
          "enum": [
            "fixed_verified",
            "refuted_verified",
            "risk_accepted",
            "unresolved"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "finding_id",
        "subject_digest",
        "resolving_actor_id",
        "review_run_id",
        "decision",
        "evidence_ids",
        "reason",
        "expires_at"
      ]
    },
    "PlanCheckReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "check_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unverifiable",
                  "not_applicable"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "minItems": 0,
                "maxItems": 256
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            },
            "required": [
              "check_id",
              "status",
              "evidence_ids",
              "reason"
            ]
          },
          "minItems": 1,
          "maxItems": 256
        },
        "blocking_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "ready_for_review": {
          "type": "boolean"
        }
      },
      "required": [
        "report_id",
        "subject_digest",
        "source_digest",
        "checks",
        "blocking_finding_ids",
        "ready_for_review"
      ]
    },
    "DecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "purpose": {
          "enum": [
            "design_choice",
            "plan_approval",
            "execution_permission",
            "source_apply",
            "acceptance",
            "publish"
          ]
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "display_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "request_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "allowed_responses": {
          "type": "array",
          "items": {
            "enum": [
              "approve",
              "reject",
              "defer",
              "cancel",
              "request_changes",
              "ask_question"
            ]
          },
          "minItems": 1,
          "maxItems": 256
        },
        "state": {
          "enum": [
            "pending",
            "answered",
            "cancelled",
            "expired",
            "stale"
          ]
        }
      },
      "required": [
        "decision_id",
        "scope",
        "purpose",
        "subject_digest",
        "display_digest",
        "request_revision",
        "nonce",
        "expires_at",
        "allowed_responses",
        "state"
      ]
    },
    "DecisionResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "display_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "response": {
          "enum": [
            "approve",
            "reject",
            "defer",
            "cancel",
            "request_changes",
            "ask_question"
          ]
        },
        "comment": {
          "type": "string",
          "maxLength": 16384
        },
        "amendment_artifact_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_work_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "client_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "decision_id",
        "expected_revision",
        "subject_digest",
        "display_digest",
        "nonce",
        "response",
        "comment",
        "amendment_artifact_id",
        "selected_work_unit_ids",
        "client_event_id"
      ],
      "description": "Untrusted UI input. Caller identity comes from authenticated transport; it is not provided by the model in this document.",
      "allOf": [
        {
          "if": {
            "properties": {
              "response": {
                "const": "approve"
              }
            },
            "required": [
              "response"
            ]
          },
          "then": {
            "properties": {
              "amendment_artifact_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "response": {
                "const": "request_changes"
              }
            },
            "required": [
              "response"
            ]
          },
          "then": {
            "properties": {
              "comment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        }
      ]
    },
    "ChangeImpact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "old_subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "new_subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "changed_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "minItems": 0,
          "maxItems": 256
        },
        "classification": {
          "enum": [
            "presentation_only",
            "authorized_lineage_progress",
            "delegated_choice",
            "execution_meaning_change",
            "unknown"
          ]
        },
        "affected_work_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "invalidated_review_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "invalidated_permit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "requires_human_decision": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "old_subject_digest",
        "new_subject_digest",
        "changed_requirements",
        "changed_paths",
        "classification",
        "affected_work_units",
        "invalidated_review_ids",
        "invalidated_permit_ids",
        "requires_human_decision",
        "reason"
      ]
    },
    "WorkflowExecutionBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "plan_subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "execution_permit_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "expected_candidate_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "workflow_digest",
        "plan_subject_digest",
        "execution_permit_id",
        "generation",
        "expected_candidate_digest",
        "scope"
      ]
    }
  }
}
