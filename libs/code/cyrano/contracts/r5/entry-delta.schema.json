{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyrano.invalid/contracts/r5/entry-delta",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_release_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "enum": [
        "add",
        "refine",
        "link",
        "deprecate"
      ]
    },
    "entry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content": {
      "type": "string",
      "maxLength": 16000
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "applies_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "does_not_apply_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "linked_entry_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "link_kind": {
      "enum": [
        "supports",
        "contradicts",
        "supersedes",
        "example_of",
        null
      ]
    }
  },
  "required": [
    "candidate_id",
    "base_release_digest",
    "operation",
    "entry_id",
    "expected_revision",
    "scope_id",
    "content",
    "evidence_ids",
    "applies_when",
    "does_not_apply_when",
    "linked_entry_id",
    "link_kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "add"
          }
        }
      },
      "then": {
        "properties": {
          "expected_revision": {
            "const": 0
          },
          "content": {
            "minLength": 1
          },
          "applies_when": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "link"
          }
        }
      },
      "then": {
        "properties": {
          "linked_entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "link_kind": {
            "enum": [
              "supports",
              "contradicts",
              "supersedes",
              "example_of"
            ]
          }
        }
      }
    }
  ]
}
